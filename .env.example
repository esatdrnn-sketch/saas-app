# ── Neon (PostgreSQL) ──────────────────────────────────────────────
# Pooled connection — Vercel/serverless runtime için (host'ta "-pooler" olmalı)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection — prisma migrate deploy için (pooler OLMAMALI)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Uygulama URL ───────────────────────────────────────────────────
# Production'da tam domain (WhatsApp linkleri için zorunlu)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── iyzico Webhook ─────────────────────────────────────────────────
# Production'da mock-valid çalışmaz; gerçek secret gerekir
IYZICO_WEBHOOK_SECRET="whsec_your_secret_key_here"

# ── Admin Paneli ────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_strong_password_here"
