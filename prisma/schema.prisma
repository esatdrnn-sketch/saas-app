generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  loginKey      String         @unique @default(uuid())
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  customerPhone       String
  customerEmail       String?
  planName            String?
  amount              Float?
  currency            String               @default("TRY")
  status              SubscriptionStatus   @default(ACTIVE)
  iyzicoSubRef        String?              @unique
  updateToken         String               @unique @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  cancellationEvents  CancellationEvent[]
  dunningAttempts     DunningAttempt[]
}

model DunningAttempt {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  attemptNumber  Int
  emailTo        String
  sentAt         DateTime     @default(now())
}

model CancellationEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  reason         CancelReason
  action         CancelOutcome
  createdAt      DateTime     @default(now())
}

enum CancelReason {
  TOO_EXPENSIVE
  TECHNICAL
  TEMPORARY
  ALTERNATIVE
}

enum CancelOutcome {
  ACCEPT_DISCOUNT
  ACCEPT_PAUSE
  CANCEL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  RECOVERED
  PAUSED
  CANCELLED
}
